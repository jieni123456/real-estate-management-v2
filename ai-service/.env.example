# ===================================================================
# ai-service 配置模板
#
# 用法：复制本文件为 .env，然后填写真实的值。
#      .env 已被 .gitignore 排除，不会进入版本库。
#
# 优先级（从高到低）：真实环境变量  >  本文件(.env)  >  代码内置默认值
#
# 注意：代码里的默认值只覆盖「非密钥」项（base_url、模型名、超时…）。
#      密钥一律不设内置默认值——源码里留一个默认 Key，等于把外置做成摆设。
#      这是沿用项目根目录 db.properties.example 里 contact.key / jwt.secret
#      的同一条策略。
# ===================================================================

# ------------------------------------------------------ 密钥（必填）
# 阿里云百炼（DashScope）控制台申请：https://bailian.console.aliyun.com/
# 控制台右上角「API-KEY」→ 创建我的 API-KEY，形如 sk-xxxxxxxx。
#
# 通义千问的 OpenAI 兼容接口同时提供对话与向量化两类模型，
# 所以下面 Chat 与 Embedding 两部分共用这一个 Key。
DASHSCOPE_API_KEY=sk-replace_with_your_own_key

# ------------------------------------------------------ 服务地址（可选）
# 北京地域的 OpenAI 兼容端点。若你的 Key 属于新加坡地域，
# 换成 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# （地域与 Key 必须匹配，用错会返回 401 invalid_api_key。）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ------------------------------------------------------ 模型名（可选）
# 若报「模型不存在 / Model not exist」，到百炼控制台「模型广场」
# 查一个你账号可用的模型名填在这里即可，代码无需改动。
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# ------------------------------------------------------ 超时与重试（可选）
# 单次请求超时（秒）。流式输出时它是「建连 + 首包」的超时。
LLM_TIMEOUT_SECONDS=30

# 最多尝试次数（含首次调用）。设 1 表示不重试。
LLM_MAX_ATTEMPTS=3

# 指数退避的基数（秒）：第 n 次失败后等待 base * 2^(n-1) 秒，再叠加 ±25% 抖动。
LLM_BACKOFF_BASE=1.0

# 退避等待的上限（秒），防止重试得太久把调用方挂死。
LLM_BACKOFF_MAX=8.0

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.realestate</groupId>
    <artifactId>realestate-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>二手房中介管理系统</name>
    <description>
        父 POM。聚合三个模块：
          realestate-core     业务核心（model / dao / service / controller / 纯逻辑 util），不依赖界面库
          realestate-desktop  Swing 桌面端（界面 + 入口）
          realestate-web      Spring Boot 服务端
        前端 frontend/ 是独立的 Vue 项目，不参与 Maven 构建。

        引入动机、选型理由与推进阶段见 需求报告.txt 第五章（R-004）。
    </description>

    <modules>
        <module>realestate-core</module>
        <module>realestate-desktop</module>
        <module>realestate-web</module>
    </modules>

    <properties>
        <!-- 源码与输出一律 UTF-8：本项目注释与界面文案均为中文，用平台默认编码会乱码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <!-- 单元测试的开关。显式给个默认值，这样 core 模块的 exec 配置里
             写 ${skipTests} 不会因为属性未定义而报错。 -->
        <skipTests>false</skipTests>

        <!-- 依赖版本集中在此，子模块一律不写 version -->
        <flatlaf.version>3.7.2</flatlaf.version>
        <mysql.version>8.0.33</mysql.version>

        <!-- JWT 签发与校验。0.12.x 的资料最全，升级到 0.13 只需改这一处 -->
        <jjwt.version>0.12.7</jjwt.version>

        <!-- 3.5.x 是目前国内企业存量最大的一条线，中文资料最全。
             升级到 4.x 只需改这一处版本号，但需另行核对第三方生态（如接口文档组件）的适配。 -->
        <spring-boot.version>3.5.16</spring-boot.version>

        <!-- 构建插件版本 -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 的依赖版本清单。
                 这里用 import 而不是让 web 模块继承 spring-boot-starter-parent——
                 一个模块只能有一个 parent，而本项目的 parent 是聚合用的父 POM。 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>${flatlaf.version}</version>
            </dependency>

            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- 本项目的三个模块之间互相引用 -->
            <dependency>
                <groupId>com.realestate</groupId>
                <artifactId>realestate-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <!-- 必须加 -parameters：Java 字节码默认不保留方法参数名，
                             而 Spring MVC 解析 @PathVariable / @RequestParam 时正是靠
                             反射读参数名（注解里没显式写名字的那种写法）。
                             少了它，所有带路径变量或查询参数的接口都会抛
                             IllegalArgumentException: Name for argument ... not specified，
                             表现为 500 —— 而且编译期毫无征兆。

                             别人的 Spring Boot 项目不踩这个坑，是因为继承
                             spring-boot-starter-parent 时它默认加了这个标志；
                             本项目为了统一管版本自己写了父 POM，所以要自己补上。 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>${maven-assembly-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

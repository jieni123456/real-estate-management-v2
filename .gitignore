*.class
out/
bin/
target/
build/

# ---- IntelliJ IDEA ----
.idea/
*.iml
*.ipr
*.iws
out/

# ---- Eclipse / NetBeans ----
.classpath
.project
.settings/
.apt_generated
.factorypath
nbproject/private/
nbbuild/
dist/
nbdist/

# ---- VS Code ----
.vscode/

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
*.tmp
*.bak
~$*

# ---- 打包产物（自行打包留档用，不入库）----
*.zip
*.rar
*.7z

# ---- 依赖 jar ----
# R-004 起依赖改由 Maven 管理（见各模块 pom.xml），仓库里不再存放第三方 jar。
# 唯一例外是 Maven Wrapper 自带的引导 jar：它是构建入口，必须入库，
# 否则 clone 下来的人没法执行 ./mvnw。
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---- 前端（Vue 3，见 frontend/）----
node_modules/
.vite/
npm-debug.log*
yarn-error.log*

# ---- 本地配置（含凭据，禁止提交）----
db.properties
*.local
.env

# ---- 本地工具数据 ----
.workbuddy/

# ---- Python（ai-service/，见 ai-service/README.md）----
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

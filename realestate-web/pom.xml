<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.realestate</groupId>
        <artifactId>realestate-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>realestate-web</artifactId>
    <name>realestate-web（Spring Boot 服务端）</name>
    <description>
        后端服务，对外提供 HTTP + JSON 接口，供 frontend/ 里的 Vue 3 前端调用。

        基包为 web：Spring Boot 的组件扫描从主类所在包向下进行，
        因此只会扫描 web.**。core 中的 model / dao / service / controller
        刻意不带 Spring 注解——它们还要被无框架的桌面端复用，
        装配到容器里由本模块的一个配置类负责（第 1 阶段做）。
    </description>

    <dependencies>
        <!-- 业务核心：两端共用同一套逻辑 -->
        <dependency>
            <groupId>com.realestate</groupId>
            <artifactId>realestate-core</artifactId>
        </dependency>

        <!-- Web MVC + 内嵌 Tomcat + Jackson（JSON） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 连接池（自带 HikariCP，版本由 Spring Boot 统一管理）。
             本模块只取它的连接池：DAO 仍走 core 的 DatabaseUtil，
             由下面 web.config.CoreIntegrationConfig 把池注入进去。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- JWT。api 参与编译，impl 与 jackson 只在运行期需要，故 scope=runtime -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 接口文档：OpenAPI 描述 + Swagger UI 页面。
             生成的不是另写的一份文档，而是从 Controller 的注解与 DTO 反射出来的 ——
             代码改了文档自动跟着变，不会出现「文档写着 200、实际返回 400」。
             版本对应 Spring Boot 3.5.16（见父 POM 的说明）。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- core 的测试基础设施（TestRunner）。
             用 test-jar 类型取 core 的测试包，避免把断言框架在本模块抄第二份。
             只在测试期需要，故 scope=test —— 它不会进入运行时依赖。 -->
        <dependency>
            <groupId>com.realestate</groupId>
            <artifactId>realestate-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 单元测试：与 core 同一套做法，入口是 webtest.WebAllTests。
                 断言内容主要是 JWT 的签发与校验（签名被改必须拒绝）——
                 这类安全相关的行为最值得用断言锁住。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                            <arguments>
                                <argument>-Dfile.encoding=UTF-8</argument>
                                <argument>-Dstdout.encoding=UTF-8</argument>
                                <argument>-Dstderr.encoding=UTF-8</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>webtest.WebAllTests</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 同 core：测试由 exec 负责，surefire 留空 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <!-- 打成可独立运行的 fat jar：java -jar realestate-web-<版本>.jar
                 注意：本模块没有继承 spring-boot-starter-parent，
                 所以 repackage 不会自动绑定，必须显式声明这个 execution。

                 skip=false 覆盖父 POM 里「默认跳过」的设置（原因见父 POM 注释）：
                 本模块是唯一真正需要 spring-boot:run / repackage 的模块。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>web.RealEstateWebApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
